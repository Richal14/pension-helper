            "kind": "={{ $json.kind }}",
            "name": "={{ $json.name }}",
            "email": "={{ $json.email }}",
            "da_old": "={{ $json.da_old }}",
            "da_new": "={{ $json.da_new }}",
            "da_new_from": "={{ $json.da_new_from }}",
            "created_at": "={{ $json.created_at }}"
          },
          "schema": [
            {
              "id": "key",
              "displayName": "key",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "kind",
              "displayName": "kind",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
