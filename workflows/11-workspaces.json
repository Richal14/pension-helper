{
  "name": "Pension Helper – Workspaces",
  "nodes": [
    {
      "id": "d6e9ed7b-b2b3-4612-8ae8-260b5b58ab5b",
      "name": "Backend saves or reads a workspace",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "pension-workspace",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {
          "onlyRunIf": "={{ $json.headers['x-pension-key'] === 'REPLACE_WITH_YOUR_N8N_SHARED_SECRET' }}"
        }
      },
      "webhookId": "a8cdd933-fe4f-4614-b668-952a372d6ed7"
    },
    {
      "id": "62f7bae1-83ab-4c07-b163-86662938e542",
      "name": "Read the request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The backend validates everything first. The key looks like w12 (one per signed-up workspace).\nconst b = $input.first().json.body || {};\nconst v = b.values || {};\nconst key = String(b.key || '');\nif (!/^w\\d{1,9}$/.test(key)) return [{ json: { action: 'invalid', key } }];\nreturn [{ json: {\n  action: b.action === 'upsert' ? 'upsert' : 'get', key,\n  kind: v.kind === 'family' ? 'family' : 'office', name: String(v.name || '').slice(0, 120), email: String(v.email || '').slice(0, 120),\n  da_old: Number(v.da_old ?? 55), da_new: Number(v.da_new ?? 58), da_new_from: String(v.da_new_from || '2026-07'),\n  created_at: v.created_at || new Date().toISOString()\n} }];"
      }
    },
    {
      "id": "1bd7176c-d4f7-4124-afed-af800a747da2",
      "name": "Save something?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.action }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "upsert"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "32d79f86-455a-4a13-995b-1ca3623a3ce2",
      "name": "Save workspace",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        660,
        200
      ],
      "parameters": {
        "resource": "row",
        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "I3jXUGaIDSHamJBB",
          "cachedResultName": "workspaces"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "key",
              "condition": "eq",
              "keyValue": "={{ $json.key }}"
