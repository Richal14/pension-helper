              "displayName": "da_new",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "canBeUsedToMatch": true
            },
            {
              "id": "da_new_from",
              "displayName": "da_new_from",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "created_at",
              "displayName": "created_at",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "dateTime",
              "canBeUsedToMatch": true
            }
          ]
        }
      }
    },
    {
      "id": "dc565e75-489c-47a6-baa1-ee337385c27d",
      "name": "Read workspace",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
