        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "I3jXUGaIDSHamJBB",
          "cachedResultName": "workspaces"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "key",
              "condition": "eq",
              "keyValue": "={{ $('Read the request').first().json.key }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "7f47a940-a41a-4c04-b9e0-e59968e1d3cb",
      "name": "Reply: workspace",
      "type": "n8n-nodes-base.respondToWebhook",
