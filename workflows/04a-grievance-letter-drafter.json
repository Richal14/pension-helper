    {
      "id": "2735cd9c-3706-450d-92e2-7e325d0dde46",
      "name": "Find who needs a new letter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Finds every pensioner with missing or short pension who does not already have a letter for the same problem.\n// Scheduled run: every signed-up workspace. 'Draft now' webhook: only the workspace in the request.\nconst WS = Object.fromEntries($('Get workspaces').all().map(i => i.json).filter(w => w.key).map(w => [w.key, w]));\nlet ONLY = null;\ntry { ONLY = String($('Backend asks to draft letters now').first().json.body?.dataset || '') || null; } catch (e) { ONLY = null; }\nconst active = r => !!r.dataset && r.dataset !== 'demo' && !!WS[r.dataset] && (!ONLY || r.dataset === ONLY);\nconst daFor = ds => { const w = WS[ds] || {}; return { old: Number(w.da_old ?? 55), nu: Number(w.da_new ?? 58), from: w.da_new_from || '2026-07' }; };\n\nconst inr = (n) => '₹' + Math.round(n).toLocaleString('en-IN');\nconst monthLabel = (m) => DateTime.fromFormat(m, 'yyyy-MM').toFormat('LLLL yyyy');\n\nconst pensioners = $('Get all pensioners').all().map(i => i.json).filter(p => p.name && active(p));\nconst payments = $('Get all pension payments').all().map(i => i.json).filter(r => r.name && r.month && active(r));\nconst existing = $('Get existing letters').all().map(i => i.json).filter(g => g.name && active(g));\nconst alreadyHas = new Set(existing.map(g => g.dataset + '|' + g.name + '|' + g.problem_summary));\n\nconst out = [];\nfor (const p of pensioners) {\n  const DA = daFor(p.dataset);\n  const problems = payments\n    .filter(r => r.name === p.name && r.dataset === p.dataset)\n    .sort((a, b) => (a.month < b.month ? -1 : 1))\n    .map(r => {\n      const da = r.month >= DA.from ? DA.nu : DA.old;\n      const expected = Math.round(r.basic_pension * (1 + da / 100) - (r.commuted_amount || 0));\n      const received = Number(r.amount_received) || 0;\n      const difference = expected - received;\n      const status = received === 0 ? 'missing' : (difference > 0 ? 'short' : 'ok');\n      return { month: r.month, expected, received, difference, status };\n    })\n    .filter(m => m.status !== 'ok');\n  if (!problems.length) continue;\n\n  const problemSummary = problems.map(m => '- ' + monthLabel(m.month) + ': expected ' + inr(m.expected) + ', received ' + inr(m.received) + ', difference ' + inr(m.difference)).join('\\n');\n  if (alreadyHas.has(p.dataset + '|' + p.name + '|' + problemSummary)) continue;\n\n  const amountShort = problems.reduce((s, m) => s + m.difference, 0);\n  const kinds = [...new Set(problems.map(m => m.status))];\n  const issueType = kinds.length > 1 ? 'missing_and_short' : kinds[0];\n\n  const templateLetter = 'To,\\nThe Branch Manager / Pension Cell,\\n' + p.bank + '\\n\\n'\n    + 'Subject: Request to release pending pension amount – PPO ending ' + p.ppo_last4 + '\\n\\n'\n    + 'Respected Sir/Madam,\\n\\n'\n    + 'I, ' + p.name + ', am a pensioner drawing my pension through your bank (PPO number ending ' + p.ppo_last4 + '). '\n    + 'On checking my bank statement, I found the following issues with my pension credits:\\n\\n'\n    + problemSummary + '\\n\\n'\n    + 'Total amount pending: ' + inr(amountShort) + '.\\n\\n'\n    + 'I kindly request you to release the pending amount at the earliest and confirm in writing. '\n    + 'I will be happy to provide any documents you need.\\n\\n'\n    + 'Thanking you,\\n\\n' + p.name + '\\nSignature: ____________\\nDate: ____________';\n\n  out.push({ json: { name: p.name, age: p.age, bank: p.bank, ppo_last4: p.ppo_last4, dataset: p.dataset, issue_type: issueType, problem_summary: problemSummary, amount_short: amountShort, template_letter: templateLetter } });\n}\nreturn out;"
      }
    },
    {
      "id": "29173392-0b6e-461d-8813-acb19dba6040",
      "name": "AI writes grievance letter",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1140,
        100
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Write the grievance letter for this pensioner.\n\nPensioner name: {{ $json.name }}\nAge: {{ $json.age }}\nBank: {{ $json.bank }}\nPPO number ends with: {{ $json.ppo_last4 }}\nTotal amount pending: {{ $json.amount_short }} rupees\nProblem months:\n{{ $json.problem_summary }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You are Pension Helper, a careful assistant for retired pensioners in India.\n\nWrite a short, formal, polite grievance letter in English from the pensioner to the Branch Manager / Pension Cell of their bank, asking them to release the missing or short pension amount.\n\nRules:\n- Start with \"To,\" then \"The Branch Manager / Pension Cell,\" and the bank name.\n- Include a clear Subject line mentioning the PPO number ending digits.\n- List each problem month with expected amount, received amount and difference. Show money in Indian format, e.g. ₹47,400.\n- State the total pending amount and make one clear request: release the pending amount and confirm in writing.\n- Never include a full account number, Aadhaar number, PIN or OTP.\n- End with \"Thanking you,\" the pensioner name, and blank lines for Signature and Date.\n- Under 220 words. Plain text only, no markdown."
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
