{
  "name": "Pension Helper – Approve or Reject a Letter",
  "nodes": [
    {
      "id": "1a91bb0d-a3da-41ca-bc49-3b9b4364c242",
      "name": "Dashboard sends a decision",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "grievance-decision",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*",
          "onlyRunIf": "={{ $json.headers['x-pension-key'] === 'REPLACE_WITH_YOUR_N8N_SHARED_SECRET' }}"
        }
      },
      "webhookId": "09ba9796-da21-452d-83d2-e46e7502acd9"
    },
    {
      "id": "258b9525-11a1-4e8f-850a-5f25f860c90c",
      "name": "Read letter id and decision",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "gid",
              "name": "id",
              "value": "={{ Number($json.body?.id ?? $json.query?.id ?? $json.id ?? 0) }}",
              "type": "number"
            },
            {
              "id": "dec",
              "name": "decision",
              "value": "={{ String($json.body?.decision ?? $json.query?.decision ?? $json.decision ?? \"\").toLowerCase().trim() }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "6f4865f7-b347-463e-9435-ede13969f601",
      "name": "Find the letter",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        480,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "rIrkxZXlFn67OxmU",
          "cachedResultName": "grievances"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      },
      "alwaysOutputData": true
    },
    {
      "id": "70319557-83b2-45e0-ac69-527153e0dc82",
      "name": "Check the request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Complaint tracker: Drafted -> Approved by office -> Sent to bank -> Resolved (or Drafted -> Rejected).\n// Each step is only allowed from the step before it. The time of every step is kept in the timeline.\nconst req = $('Read letter id and decision').first().json;\nconst g = $input.first().json || {};\nconst fail = (message) => [{ json: { ok: false, id: req.id, message } }];\n\nconst MOVES = {\n  approve:       { from: 'draft',    to: 'approved', verb: 'approved' },\n  reject:        { from: 'draft',    to: 'rejected', verb: 'rejected' },\n  mark_sent:     { from: 'approved', to: 'sent',     verb: 'marked as sent to the bank' },\n  mark_resolved: { from: 'sent',     to: 'resolved', verb: 'marked as resolved' }\n};\n\nif (!g.id) return fail('No letter found with id ' + req.id + '.');\nconst move = MOVES[req.decision];\nif (!move) return fail('Decision must be approve, reject, mark_sent or mark_resolved.');\nif (g.status !== move.from) return fail('This letter is ' + g.status + ', so it cannot be ' + move.verb + '.');\n\nlet timeline = {};\ntry { timeline = JSON.parse(g.timeline || '{}') || {}; } catch (e) { timeline = {}; }\nif (!timeline.drafted && g.created_at) timeline.drafted = g.created_at;\nif (g.status !== 'draft' && g.approved_at) { const k = g.status === 'rejected' ? 'rejected' : 'approved'; if (!timeline[k]) timeline[k] = g.approved_at; }\nconst now = DateTime.now().toISO();\ntimeline[move.to] = now;\n\nreturn [{ json: {\n  ok: true, id: g.id, name: g.name, bank: g.bank, new_status: move.to,\n  approved_at: (req.decision === 'approve' || req.decision === 'reject') ? now : (g.approved_at || now),\n  timeline: JSON.stringify(timeline),\n  message: 'Letter for ' + g.name + ' is now ' + move.to + '.'\n} }];"
      }
    },
    {
      "id": "331843a6-87f4-436f-bec2-d7ca10a1f021",
      "name": "Request OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "468fd2fc-010b-4198-972a-a34e1b22e529",
      "name": "Save the decision",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "rIrkxZXlFn67OxmU",
          "cachedResultName": "grievances"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "={{ $json.new_status }}",
            "approved_at": "={{ $json.approved_at }}",
            "timeline": "={{ $json.timeline }}"
          },
          "schema": [
            {
              "id": "status",
              "displayName": "status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "approved_at",
              "displayName": "approved_at",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "dateTime",
              "canBeUsedToMatch": true
            },
            {
              "id": "timeline",
              "displayName": "timeline",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        }
      }
    },
    {
      "id": "2cd1b408-684d-4102-8fd3-4b363240a9ae",
      "name": "Reply: decision saved",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Check the request').first().json) }}"
      },
      "executeOnce": true
    },
    {
      "id": "cf011409-ab93-4257-bcd5-512b06871626",
      "name": "Reply: request refused",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1200,
        420
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "c870c9a8-25c8-4c20-92a3-8cf52333485f",
      "name": "Sticky Note fed9ddf3",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -20
      ],
      "parameters": {
        "content": "## Pension Helper – Approve or Reject a Letter\nCalled by the dashboard: POST /grievance-decision with {\"id\": 3, \"decision\": \"approve\"} (or \"reject\").\n\nOnly **draft** letters can be decided. The decision and its time are saved in the grievances table (approved_at holds the decision time for both). Nothing is emailed to the bank.",
        "color": 4,
        "width": 540,
        "height": 220
      }
    }
  ],
  "connections": {
    "Dashboard sends a decision": {
      "main": [
        [
          {
            "node": "Read letter id and decision",
