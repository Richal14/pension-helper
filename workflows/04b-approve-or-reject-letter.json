      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false,
  "meta": {
    "description": "Pension Helper: dashboard API to approve or reject a draft grievance letter (POST /grievance-decision {id, decision}). Updates the grievances table; sends nothing."
  }
}
