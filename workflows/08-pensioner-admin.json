  "nodes": [
    {
      "id": "82352d7d-920c-47be-9412-8082db9839bd",
      "name": "Backend changes a pensioner",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "pensioner-admin",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {
          "onlyRunIf": "={{ $json.headers['x-pension-key'] === 'REPLACE_WITH_YOUR_N8N_SHARED_SECRET' }}"
        }
      },
      "webhookId": "f1e8e930-1bfc-44db-99a9-28c13689b142"
    },
    {
      "id": "b664091b-b483-4dc2-9975-5bc057b4a3cf",
      "name": "Read the request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The backend has already checked and cleaned every field (account numbers arrive as last 4 digits only).\n// action \"create_many\" adds a whole pensioner list (one item per pensioner).\nconst b = $input.first().json.body || {};\nconst dataset = /^w\\d{1,9}$/.test(String(b.dataset || '')) ? String(b.dataset) : 'invalid';\nconst one = (p, action) => ({\n  action, dataset,\n  id: Number(b.id) || 0,\n  old_name: String(b.old_name || ''),\n  name: String(p.name || ''), age: Number(p.age) || null, bank: String(p.bank || ''), language: String(p.language || ''),\n  family_email: String(p.family_email || ''), ppo_last4: String(p.ppo_last4 || ''), bank_account_last4: String(p.bank_account_last4 || ''),\n  basic_pension: Number(p.basic_pension) || 0, commuted_amount: Number(p.commuted_amount) || 0,\n  consent_given_at: p.consent_given_at || null, consent_by: String(p.consent_by || ''),\n  lc_submitted: !!p.lc_verified_until, lc_submitted_on: p.lc_submitted_on || null,\n  pramaan_id: p.pramaan_id || null, lc_verified_until: p.lc_verified_until || null,\n  lc_recorded_by: p.lc_verified_until ? 'office' : null\n});\nif (b.action === 'create_many') return (b.pensioners || []).map(p => ({ json: one(p, 'create') }));\nreturn [{ json: one(b.pensioner || {}, String(b.action || '')) }];"
      }
    },
    {
      "id": "f7f707a5-688c-42f3-8433-8043877a2d0a",
      "name": "Which change?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "create",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "create"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "update",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "update"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "delete",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "delete"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        }
      }
    },
