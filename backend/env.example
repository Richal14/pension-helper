# Copy this file to backend/.env and fill in your values. Never commit backend/.env.
# The n8n webhook URLs live ONLY here: the web pages never see them.
N8N_OVERVIEW_URL=https://YOUR-N8N-HOST/webhook/pension-overview
N8N_CHECK_URL=https://YOUR-N8N-HOST/webhook/pension-check
N8N_DECISION_URL=https://YOUR-N8N-HOST/webhook/grievance-decision
N8N_RECORD_URL=https://YOUR-N8N-HOST/webhook/record-life-certificate
N8N_ADMIN_URL=https://YOUR-N8N-HOST/webhook/pensioner-admin
N8N_IMPORT_URL=https://YOUR-N8N-HOST/webhook/import-payments
N8N_WORKSPACE_URL=https://YOUR-N8N-HOST/webhook/pension-workspace
N8N_DRAFT_URL=https://YOUR-N8N-HOST/webhook/draft-letters
# Any long random text. Signs the login cookie.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=8
# Optional: secret for the family status fingerprint (PPO + date of birth). Defaults to SESSION_SECRET.
# Changing it means every pensioner's date of birth must be entered again.
LOOKUP_SECRET=
# Long random text. Sent to n8n in the X-Pension-Key header; each n8n webhook's
# "Only Run If" option must check for the same value, or n8n ignores the request.
N8N_SHARED_SECRET=change-me-to-another-long-random-string

# ---- Only for hosting that wipes the disk on restart (e.g. Render's free plan) ----
# Copies accounts, workspaces and family-check fingerprints to the n8n "backend_store" table and
# reloads them on start. Leave it EMPTY on your own computer (one backup per hosted copy).
N8N_STORE_URL=
# Optional sample Pension Office account, recreated automatically if it is missing.
# SEED_WORKSPACE_KEY links it to sample data already in n8n (a "w" + 9 digits key).
SEED_OFFICE_EMAIL=
SEED_OFFICE_PASSWORD=
SEED_WORKSPACE_KEY=
